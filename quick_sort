#10.     Хоёр массивыг нэгтгэж эрэмбэлэх

def quick_sort(arr):
    if len(arr) <= 1:
        return arr
    pivot = arr[len(arr) // 2]
    left = []
    middle = []
    right = []
    for num in arr:
        if num < pivot:
            left.append(num)
        elif num == pivot:
            middle.append(num)
        else:
            right.append(num)
    return quick_sort(left) + middle + quick_sort(right)
a = [8, 3, 5]
b = [2, 9, 1]
print(quick_sort(a + b))