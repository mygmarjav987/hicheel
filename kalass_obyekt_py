class sdudent:
    def __init__(self, name, score, irts):
        self.name = name
        self.score = score
        self.irts = irts
    def check_result(self):
        if 60 <= self.score and 80 <= self.irts:
            print(self.name,"tentssn")
        else:
            print(self.name,"tentseegui")
sdudent1 = sdudent("mygmarjav", 100, 90)
sdudent1.check_result()
sdudent2 = sdudent("erdembileg", 100, 70)
sdudent2.check_result()